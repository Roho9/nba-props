# Copy to backend/.env. Never commit real keys; the frontend never sees these values.

# Slate date is computed in this time zone (NBA slates are dated in US Eastern).
TIMEZONE=America/New_York

# ESPN public JSON endpoints: undocumented, no key, no published API terms. Personal research use only.
# Set to false to disable (the app then has no schedule/box score source unless you add one).
ESPN_ENABLED=true

# The Odds API (https://the-odds-api.com). Free tier: 500 credits/month. One refresh costs
# (#markets x #regions) credits PER GAME, so 12 markets x 1 region x 9 games = 108 credits.
# Leave blank to use DraftKings via ESPN only. Paid plans start around $30/month (20k credits).
ODDS_API_KEY=
ODDS_API_REGIONS=us
ODDS_API_BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us

# Optional: lets an LLM rephrase the deterministic research note. It cannot add numbers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Refresh cadence and freshness limits (minutes)
AUTO_REFRESH_MIN=30
ODDS_STALE_AFTER_MIN=45
INJURIES_STALE_AFTER_MIN=120

# Database (SQLite default; PostgreSQL works with a postgresql+psycopg:// URL and `pip install psycopg[binary]`)
# DATABASE_URL=sqlite:///data/nba_props.sqlite3
